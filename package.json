    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:publication": "node scripts/check-publication.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json README.md docs .github",
    "deploy": "gh-pages -d out"
  },

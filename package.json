{
  "name": "siteadam",
  "version": "1.0.0",
  "description": "Site institucional e demonstração interativa do projeto A.D.A.M.",
  "scripts": {
    "test": "playwright test",
    "assets": "node scripts/generate-social-image.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
